# =============================================================================
# AGENT TEMPLATE — GENERAL
# =============================================================================
# IMPORTANT — two files, two purposes:
#   • `.env`     → LOCAL dev only. Copy this file to `.env` and fill it in. It is
#                  read by `poe dev`; `dooers push` does NOT inject it as runtime
#                  env vars on the hosted deploy.
#   • `env.prod` → HOSTED runtime. Create it with your production values
#                  (OPENAI_API_KEY, AGENT_DATABASE_*, …). `dooers push` injects
#                  `env.<env>` (e.g. env.prod) into Cloud Run.
# `.gitignore` keeps both out of git — never commit secrets.
#
# HTTP_PORT is local dev only — the hosted container binds the platform's $PORT
# (Cloud Run = 8080), set by the Dockerfile CMD.
HTTP_PORT=8005
# Serve routes at `/` (default). Keep this FALSE for hosted deploys: the Dooers load
# balancer routes https://agents.dooers.ai/<agent-id>/… and strips the /<agent-id>
# prefix before forwarding, so the agent must serve at `/` (matching `message_path: /`
# in dooers.yaml). Only set true for local multi-agent routing behind a shared proxy.
USE_API_PREFIX=false
API_ENVIRONMENT=dev
API_AGENT_NAME=dooers-starter
# Public origin of the deployed agent (HTTPS). Used to build absolute links the agent
# hands to the platform (knowledge-base file links). Local dev uses localhost.
SERVICE_URL=http://localhost:8005
# Optional display fallback (see src/config.py — ASSISTANT_NAME)
ASSISTANT_NAME=Assistant
# Root log level for this process (DEBUG, INFO, …). Azure SDK / httpx stay at WARNING by default — see configure_logging() in src/main.py.
LOGGING_LEVEL=INFO
# When true, configuration problems abort startup (sys.exit). Default false so the hosted deploy
# boots in degraded mode if a secret/DB is missing. Set true locally to catch misconfig early.
CONFIG_STRICT=false

# =============================================================================
# DATABASE (agent threads / events / settings)
# =============================================================================
# "postgres" (default): you provide the DB via AGENT_DATABASE_* below.
# "dooers": Dooers-managed database (AlloyDB via IAM, no password) — set
#   `database.type: dooers` in dooers.yaml and AGENT_DATABASE_TYPE=dooers in
#   env.prod; the platform injects INSTANCE/USER/NAME on deploy. See README.
AGENT_DATABASE_TYPE=postgres
AGENT_DATABASE_HOST=localhost
AGENT_DATABASE_PORT=5432
AGENT_DATABASE_USER=postgres
AGENT_DATABASE_PASSWORD=postgres
AGENT_DATABASE_NAME=dooers_agent
AGENT_DATABASE_SSL=false

# Optional asyncpg pool for app RAG SQL tables (agent_rag_vector_store, …) — separate from
# the SDK persistence store. Set false when using AGENT_DATABASE_TYPE=dooers (managed AlloyDB)
# or when the agent does not need SQL-backed RAG metadata on deploy.
APP_POSTGRES_POOL_ENABLED=true

# =============================================================================
# STORAGE & UPLOADS (chat + shared GCS/Azure credentials)
# =============================================================================
# Chat ContentPart allowlist for SDK event.create (see AgentConfig.allowed_content_types).
AGENT_ALLOWED_CONTENT_TYPES=text,audio,image
# Ops: durable chat blobs when creator enables persist_chat_attachments + POST /uploads with agent_id.
STORE_CHAT_UPLOADS=false
# Chat blob backend for SDK: none | gcp | azure
CHAT_STORAGE_SERVICE=none

# GCS — bucket name; auth via GOOGLE_APPLICATION_CREDENTIALS or workload identity (ADC)
GCP_BUCKET_NAME=
# GCS — path to YOUR service account JSON locally (never commit this file).
# LOCAL DEV ONLY — do NOT put this in env.prod; Cloud Run uses the tenant service account (ADC).
GOOGLE_APPLICATION_CREDENTIALS=

# Azure Blob — same credentials used for chat blobs (SDK) and RAG archive (template) when you pick azure
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=

# Optional — SDK signed read URLs for chat artifacts (see dooers.config.AgentConfig)
# CHAT_ARTIFACT_SIGNED_URL_TTL_MINUTES=60

# =============================================================================
# RAG — vector pipeline & archive of upload originals
# =============================================================================
# Vector index: openai (OpenAI vector store) | azure_ai_search
RAG_PIPELINE=openai
# Ops: write RAG **original file** copies to blob (upload_archive_bytes). Needs RAG_STORAGE_SERVICE=gcp|azure.
# Blob key layout: rag-artifacts/v1/{agent_id}/{field_id}/{artifact_ref}/{filename}
STORE_RAG_UPLOADS=false
# Blob destination for RAG originals: none | gcp | azure
RAG_STORAGE_SERVICE=none

# =============================================================================
# RAG — Azure AI Search (when using RAG_PIPELINE=azure_ai_search or env fallback)
# =============================================================================
AZURE_AI_SEARCH_ENDPOINT=https://YOUR_SEARCH_RESOURCE.search.windows.net
AZURE_AI_SEARCH_API_KEY=
AZURE_AI_SEARCH_INDEX_PREFIX=dooers-kb
AZURE_AI_SEARCH_VERIFY_READ_AFTER_WRITE=0

# =============================================================================
# LLM — OpenAI API (RAG_PIPELINE=openai; also exported for Agents SDK traces)
# =============================================================================
OPENAI_API_KEY=

# =============================================================================
# DOOERS PLATFORM
# =============================================================================
DOOERS_ANALYTICS_WEBHOOK_URL=http://localhost:4000/api/v2/webhooks/analytics
AGENT_SEED_SECRET=

# Observability (optional) — empty uses SDK platform defaults
# (Core https://api.dooers.ai , OTel https://observability.dooers.ai).
# Local staging example:
# AGENT_CORE_BASE_URL=https://api-v2.dev.dooers.ai
# AGENT_OTEL_SERVICE_URL=https://observability.dev.dooers.ai
# OTEL_SERVICE_NAME=dooers-starter

# WhatsApp tools base URL (can include path prefix).
# Default in code is https://services.dooers.ai/whatsapp
# DOOERS_WHATSAPP_TOOLS_BASE=https://services.dooers.ai/whatsapp
# Inbound webhook path is `/whatsapp/inbound` (from dooers.yaml). On a hosted deploy
# the platform reaches it at https://agents.dooers.ai/<agent-id>/whatsapp/inbound and
# the LB strips the /<agent-id> prefix, so the route stays `/whatsapp/inbound` — this
# requires USE_API_PREFIX=false. Locally it is {SERVICE_URL}{api_prefix}/whatsapp/inbound.

# -----------------------------------------------------------------------------
# Chat / LLM via Azure OpenAI, STT/TTS — configure in agent settings UI, not here.
# -----------------------------------------------------------------------------
