# =============================================================================
# DOOERS AGENT STARTER — LOCAL DEV (.env)
# =============================================================================
# Two files, two purposes:
#   • `.env`     → local only (`poe dev`). Copy this file to `.env` and fill it in.
#   • `env.prod` → hosted runtime; `dooers push` injects it. See env.prod.example.
# Both are gitignored. Never commit secrets.

HTTP_PORT=8000
USE_API_PREFIX=false
API_ENVIRONMENT=dev
API_AGENT_NAME=dooers-starter
# Public origin used to build absolute links (audio replies, uploads). Local = localhost.
SERVICE_URL=http://localhost:8000
ASSISTANT_NAME=Assistant
LOGGING_LEVEL=INFO
# true → abort startup on configuration problems (useful locally). Hosted keeps false (degraded boot).
CONFIG_STRICT=false

# =============================================================================
# LLM — Dooers Gateway (OpenAI-compatible; the key's allow-list drives the Studio model picker)
# =============================================================================
DOOERS_GATEWAY_API_KEY=dk_live_...
DOOERS_GATEWAY_BASE_URL=https://llm.dooers.ai/v1
# Default model when the creator has not chosen one in Studio.
DEFAULT_LLM_MODEL=glm-5-maas
# Optional: vendor-direct OpenAI key. Only needed for audio (STT/TTS) or as a BYO fallback
# when DOOERS_GATEWAY_API_KEY is empty.
OPENAI_API_KEY=

# =============================================================================
# KNOWLEDGE — managed Dooers RAG (leave empty to disable the knowledge base)
# =============================================================================
DOOERS_RAG_SERVICE_URL=
# Secret used to mint service tokens for Dooers services (RAG, WhatsApp…). Required for RAG.
AGENT_SEED_SECRET=

# =============================================================================
# DATABASE (threads / events / settings / processed documents)
# =============================================================================
# postgres (local) | dooers (managed; platform injects connection on deploy)
AGENT_DATABASE_TYPE=postgres
AGENT_DATABASE_HOST=localhost
AGENT_DATABASE_PORT=5432
AGENT_DATABASE_USER=postgres
AGENT_DATABASE_PASSWORD=postgres
AGENT_DATABASE_NAME=dooers_agent
AGENT_DATABASE_SSL=false

# =============================================================================
# CHAT INPUT & STORAGE
# =============================================================================
# Content parts the agent accepts: text,audio,image,document
AGENT_ALLOWED_CONTENT_TYPES=text,audio,image,document
STORE_CHAT_UPLOADS=false
# none | gcp | dooers
CHAT_STORAGE_SERVICE=none
GCP_BUCKET_NAME=
# Local only — path to a service account JSON (never commit it). Hosted uses ADC.
GOOGLE_APPLICATION_CREDENTIALS=

# =============================================================================
# CHANNELS
# =============================================================================
# WhatsApp messages sent by other humans on the same number: ignore | register | dispatch
WHATSAPP_PEER_MESSAGE=register
# DOOERS_WHATSAPP_TOOLS_BASE=

# =============================================================================
# SKILLS & OBSERVABILITY
# =============================================================================
# Folder with built-in Skills (*.md with frontmatter). Studio uploads are merged on top.
SKILLS_DIR=skills
# Usually omit — SDK defaults to the Dooers platform endpoints.
# AGENT_CORE_BASE_URL=
# AGENT_OTEL_SERVICE_URL=
# OTEL_SERVICE_NAME=dooers-starter
# DOOERS_ANALYTICS_WEBHOOK_URL=
