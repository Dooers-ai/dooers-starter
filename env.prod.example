# =============================================================================
# env.prod — HOSTED runtime (Cloud Run)
# =============================================================================
# Copy to env.prod, fill secrets, and run `dooers push`. Never commit env.prod.
# The CLI injects env.<env> (e.g. env.prod) as runtime env vars — `.env` is NOT sent.
#
# Managed database (database.type: dooers in dooers.yaml):
#   - Set AGENT_DATABASE_TYPE=dooers below
#   - Set APP_POSTGRES_POOL_ENABLED=false (app RAG pool uses password DSN; SDK uses IAM)
#   - Do NOT set AGENT_DATABASE_HOST/PORT/USER/PASSWORD/NAME — platform injects them
#   - Do NOT set GOOGLE_APPLICATION_CREDENTIALS — Cloud Run uses ADC (tenant SA)
#
# Self-hosted Postgres (database.type: postgres):
#   - Set AGENT_DATABASE_TYPE=postgres (or omit)
#   - Fill AGENT_DATABASE_* with a DB reachable from Cloud Run (not localhost)
#   - APP_POSTGRES_POOL_ENABLED=true if you use RAG settings-upload SQL metadata
# =============================================================================

HTTP_PORT=8080
USE_API_PREFIX=false
API_ENVIRONMENT=prod
API_AGENT_NAME=my-agent
ASSISTANT_NAME=Assistant
LOGGING_LEVEL=INFO
CONFIG_STRICT=false

# --- Managed DB (uncomment block and remove self-hosted block below) ---
# AGENT_DATABASE_TYPE=dooers
# APP_POSTGRES_POOL_ENABLED=false

# --- Self-hosted Postgres (default) ---
AGENT_DATABASE_TYPE=postgres
AGENT_DATABASE_HOST=YOUR_DB_HOST
AGENT_DATABASE_PORT=5432
AGENT_DATABASE_USER=YOUR_DB_USER
AGENT_DATABASE_PASSWORD=YOUR_DB_PASSWORD
AGENT_DATABASE_NAME=YOUR_DB_NAME
AGENT_DATABASE_SSL=true
APP_POSTGRES_POOL_ENABLED=true

RAG_PIPELINE=openai
STORE_RAG_UPLOADS=false
RAG_STORAGE_SERVICE=none
STORE_CHAT_UPLOADS=false
CHAT_STORAGE_SERVICE=none
AGENT_ALLOWED_CONTENT_TYPES=text,audio,image

OPENAI_API_KEY=sk-...

# Observability — usually omit (SDK defaults to production Core + observability.dooers.ai).
# AGENT_CORE_BASE_URL=
# AGENT_OTEL_SERVICE_URL=
# OTEL_SERVICE_NAME=my-agent

# SERVICE_URL is often set automatically by the platform after first deploy.
# SERVICE_URL=https://agents.dooers.ai/<agent-id>
