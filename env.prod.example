# =============================================================================
# env.prod — HOSTED runtime. Copy to env.prod, fill secrets, run `dooers push`.
# Never commit env.prod. `.env` is NOT sent to the hosted runtime.
# =============================================================================
USE_API_PREFIX=false
API_ENVIRONMENT=prod
API_AGENT_NAME=my-agent
ASSISTANT_NAME=Assistant
LOGGING_LEVEL=INFO
CONFIG_STRICT=false

# LLM via Dooers Gateway
DOOERS_GATEWAY_API_KEY=dk_live_...
DOOERS_GATEWAY_BASE_URL=https://llm.dooers.ai/v1
DEFAULT_LLM_MODEL=glm-5-maas
# Only for audio (STT/TTS)
# OPENAI_API_KEY=

# Managed RAG (knowledge base)
DOOERS_RAG_SERVICE_URL=https://rag.dooers.ai
AGENT_SEED_SECRET=...

# --- Managed database (recommended; dooers.yaml → database.type: dooers) ---
AGENT_DATABASE_TYPE=dooers
# Do NOT set AGENT_DATABASE_HOST/PORT/USER/PASSWORD/NAME — the platform injects them.

# --- Self-hosted Postgres (alternative) ---
# AGENT_DATABASE_TYPE=postgres
# AGENT_DATABASE_HOST=YOUR_DB_HOST
# AGENT_DATABASE_PORT=5432
# AGENT_DATABASE_USER=YOUR_DB_USER
# AGENT_DATABASE_PASSWORD=YOUR_DB_PASSWORD
# AGENT_DATABASE_NAME=YOUR_DB_NAME
# AGENT_DATABASE_SSL=true

AGENT_ALLOWED_CONTENT_TYPES=text,audio,image,document
STORE_CHAT_UPLOADS=false
CHAT_STORAGE_SERVICE=none
WHATSAPP_PEER_MESSAGE=register

# Observability — usually omit (SDK defaults to the platform endpoints).
# AGENT_CORE_BASE_URL=
# AGENT_OTEL_SERVICE_URL=
# OTEL_SERVICE_NAME=my-agent
# SERVICE_URL is set by the platform after the first deploy.
# SERVICE_URL=https://agents.dooers.ai/<agent-id>
